# ============================================================
# SharePoint 自動アップロード 設定ファイル
# このファイルを .env.upload にコピーして値を入力してください
# ============================================================

# ── Azure AD（Microsoft Entra ID）設定 ──────────────────────
# Azure Portal > アプリの登録 で取得
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your-client-secret-here

# ── SharePoint ファイル設定 ──────────────────────────────────
# サイトID: Graph Explorer で確認
# https://graph.microsoft.com/v1.0/sites?search=サイト名
SHAREPOINT_SITE_ID=your-tenant.sharepoint.com,xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx,xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ファイルの指定方法（どちらか一方を設定）
# 方法1: ファイルID（推奨）- Graph Explorer で確認
SHAREPOINT_FILE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 方法2: ファイルパス（ファイルIDが不明な場合）
# SHAREPOINT_FILE_PATH=/Shared Documents/データ/売上管理.xlsx

# ── csv-upload-app 設定 ──────────────────────────────────────
APP_URL=https://your-app.vercel.app
APP_USERNAME=your-username
APP_PASSWORD=your-password

# ── アップロード設定（任意） ─────────────────────────────────
UPLOAD_WORKER_NAME=
UPLOAD_TEAM_NAME=
UPLOAD_WORK_HOURS=

# ── Excel シート設定 ─────────────────────────────────────────
EXCEL_SHEET_NAME=        # 空欄=最初のシート、シート名を指定も可
EXCEL_HEADER_ROW=1       # ヘッダーが何行目か（通常は1）
